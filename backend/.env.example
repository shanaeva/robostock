# Backend only. Keep credentials/port in sync with the root Compose .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://starter:starter_local_only@127.0.0.1:5432/starter

# Auth. Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_min_32_chars_long_random_string_here
AUTH_CODE_SECRET=change_me_min_32_chars_long_random_string_here
CSRF_SECRET=change_me_min_32_chars_long_random_string_here

# Optional
# FRONTEND_ORIGIN=http://localhost:3000
# AUTH_EMAIL_ENABLED=true
# AUTH_RATE_LIMIT_ENABLED=true

# SMTP (defaults: Mailpit on localhost:1025)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=RoboStock <no-reply@robostock.local>
